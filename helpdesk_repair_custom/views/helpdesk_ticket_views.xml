                <!-- Receipt (first, for RUG / normal with serial) -->
                <xpath expr="//button[@name='action_repair_order_form']" position="after">
                    <button type="action" name="%(stock.act_stock_return_picking)d"
                            groups="stock.group_stock_user"
                            string="Receipt"
                            invisible="['|','|','|','|','|','|','|',('x_studio_cancelled','=',True),('use_product_returns','=',False),('ticket_type_id','=',False),('x_studio_valid_return','=',True),('x_studio_rug_repair','=',True),('x_studio_normal_repair_with_serial_no','=',True),('x_studio_normal_repair_without_serial_no','=',False),'&amp;',('x_studio_normal_repair_without_serial_no','=',True),('x_studio_repair_serial_created','=',False)]"
                            context="{'default_ticket_id': id, 'default_company_id': company_id, 'default_location_id': x_studio_virtual_location_id, 'default_picking_id': x_studio_pick_id}"/>
                </xpath>

                <!-- Receipt (second, for normal without serial → after first Receipt) -->
                <xpath expr="//header/button[@name='%(stock.act_stock_return_picking)d'][2]" position="after">
                    <button type="action" name="%(stock.act_stock_return_picking)d"
                            groups="stock.group_stock_user"
                            string="Receipt"
                            invisible="['|','|','|','|','|','|','|',('x_studio_cancelled','=',True),('use_product_returns','=',False),('ticket_type_id','=',False),('x_studio_valid_return','=',True),('x_studio_rug_repair','=',True),('x_studio_normal_repair_with_serial_no','=',False),('x_studio_normal_repair_without_serial_no','=',True),'&amp;',('x_studio_normal_repair_without_serial_no','=',False),('x_studio_sn_updated','=',False)]"
                            context="{'default_ticket_id': id, 'default_company_id': company_id, 'default_picking_id': x_studio_pick_id}"/>
                </xpath>

                <!-- Create Repair Serial button (before third Receipt) -->
                <xpath expr="//header/button[@name='%(stock.act_stock_return_picking)d'][3]" position="before">
                    <button type="action" name="%(helpdesk_repair_custom.action_create_repair_serial)d"
                            string="Create Repair Serial" class="btn-primary"
                            confirm="Are you sure you want to create repair serial no?"
                            invisible="['|','|','|','|','|','|','|','|',('x_studio_cancelled','=',True),('use_product_returns','=',False),('ticket_type_id','=',False),('x_studio_rug_repair','=',True),('x_studio_normal_repair_with_serial_no','=',True),('x_studio_normal_repair_without_serial_no','=',False),('x_studio_normal_repair_without_serial_no','!=',True),'&amp;',('x_studio_normal_repair_without_serial_no','=',True),('x_studio_repair_serial_created','=',True),'&amp;',('x_studio_normal_repair_without_serial_no','=',True),('x_studio_tracking','!=','serial')]"
                            context="{'default_ticket_id': id, 'default_company_id': company_id, 'default_picking_id': x_studio_pick_id}"/>
                </xpath>

                <!-- Create Repair Route button (before Create Repair Serial) -->
                <xpath expr="//header/button[@name='%(helpdesk_repair_custom.action_create_repair_serial)d']"
                       position="before">
                    <button type="action" name="%(helpdesk_repair_custom.action_create_repair_route)d"
