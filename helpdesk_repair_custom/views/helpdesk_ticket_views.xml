                            confirm="Are you sure you want to create repair route?"
                            invisible="['|','|','|','|','|','|','|','|',('x_studio_cancelled','=',True),('use_product_returns','=',False),('ticket_type_id','=',False),('x_studio_rug_repair','=',True),('x_studio_normal_repair_with_serial_no','=',True),('x_studio_normal_repair_without_serial_no','=',False),('x_studio_normal_repair_without_serial_no','!=',True),'&amp;',('x_studio_normal_repair_without_serial_no','=',True),('x_studio_repair_serial_created','=',True),'&amp;',('x_studio_normal_repair_without_serial_no','=',True),('x_studio_tracking','!=','none')]"
                            context="{'default_ticket_id': id, 'default_company_id': company_id, 'default_picking_id': x_studio_pick_id}"/>
                </xpath>

            </data>
        </field>
    </record>

